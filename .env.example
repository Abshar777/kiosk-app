# Ports (dev)
API_PORT=4000
WEB_PORT=3000
API_HOST=0.0.0.0

# Where the kiosk web server proxies /api to. Read at RUNTIME, so the same
# build can be re-pointed by restarting with a different value.
# API_URL=http://localhost:4000

# Only set this if the BROWSER must call the API directly on another origin.
# It is inlined into the bundle at BUILD time and requires CORS on the API.
# NEXT_PUBLIC_API_URL=

# Razorpay (rzp_test_* keys run in sandbox)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Optional
# ADMIN_TOKEN=
# PAYMENT_LATENCY_MS=1200
# PAYMENT_FAILURE_RATE=0
# DEFAULT_COUNTRY_CODE=91
